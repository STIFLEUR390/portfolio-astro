          },
          "properties": {
            "security-severity": "0.0",
            "strix_vuln_class_hash": "fd5a606933661a9d00e30f503ba6ebe4d840cb3c1b50c79b5da0fe5ec4e91d79",
            "synthetic_location": true,
            "strix": {
              "id": "vuln-0002",
              "severity": "info",
