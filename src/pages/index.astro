---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, projects, skills, images, bio } from '../data/portfolio';
import { getPosts } from '../lib/ghost';

const featuredProjects = projects.filter((p) => p.featured);
const techCount = Object.values(skills).flat().length;

let latestPosts: any[] = [];
try {
  latestPosts = (await getPosts()).slice(0, 3);
} catch {}
---

<BaseLayout>
  <!-- Hero -->
  <section class="grid min-h-[85vh] items-center gap-12 py-20 lg:grid-cols-5">
    <div class="lg:col-span-3">
      <div class="reveal">
        <p class="mb-4 text-sm font-medium text-primary">Developpeur FullStack</p>
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl lg:text-6xl leading-[1.1]">
          {site.author}
        </h1>
      </div>
      <p class="reveal reveal-delay-1 mt-6 max-w-xl text-lg leading-relaxed text-muted-foreground">
        {site.description}
      </p>
      <div class="reveal reveal-delay-2 mt-8 flex flex-wrap gap-3">
        <a
          href="/contact"
          class="inline-flex h-11 items-center rounded-lg bg-primary px-6 text-sm font-medium text-primary-foreground transition-all duration-200 hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 active:scale-[0.98]"
        >
          Discutons de votre projet
        </a>
        <a
          href="/projets"
          class="inline-flex h-11 items-center rounded-lg border border-border/60 px-6 text-sm font-medium transition-all duration-200 hover:bg-accent hover:text-foreground active:scale-[0.98]"
        >
          Voir les projets
        </a>
      </div>
    </div>
    <div class="reveal reveal-delay-1 hidden lg:flex lg:col-span-2 lg:justify-end">
      <div class="relative">
        <div class="absolute -inset-3 rounded-2xl bg-primary/5 blur-xl"></div>
        <picture>
          <source srcset={images.profile.large} type="image/webp" />
          <img
            src={images.profile.fallback}
            alt={site.author}
            class="relative h-72 w-72 rounded-2xl object-cover ring-1 ring-border/50"
            width="320" height="320"
            loading="eager"
          />
        </picture>
      </div>
    </div>
  </section>

  <!-- Quick stats -->
  <section class="reveal border-y border-border/50 py-10">
    <div class="grid grid-cols-3 gap-6 text-center">
      <div>
        <p class="text-3xl font-bold tracking-tight text-foreground">6+</p>
        <p class="mt-1 text-sm text-muted-foreground">Annees d'experience</p>
      </div>
      <div>
        <p class="text-3xl font-bold tracking-tight text-foreground">{featuredProjects.length}+</p>
        <p class="mt-1 text-sm text-muted-foreground">Projets livres</p>
      </div>
      <div>
        <p class="text-3xl font-bold tracking-tight text-foreground">{techCount}</p>
        <p class="mt-1 text-sm text-muted-foreground">Technologies</p>
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="py-20">
    <h2 class="reveal text-lg font-semibold">Stack technique</h2>
    <div class="reveal reveal-delay-1 mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {Object.entries(skills).map(([category, items], i) => (
        <div class:list={['reveal', `reveal-delay-${Math.min(i + 1, 3)}`]}>
          <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-muted-foreground">{category}</h3>
          <div class="flex flex-wrap gap-2">
            {items.map((skill) => (
              <span class="inline-block rounded-lg border border-border/60 bg-card px-3 py-1.5 text-xs font-medium transition-colors duration-200 hover:border-primary/30 hover:text-primary">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="py-20">
    <div class="reveal flex items-end justify-between">
      <div>
        <h2 class="text-lg font-semibold">Projets vedettes</h2>
        <p class="mt-1 text-sm text-muted-foreground">Une selection de projets recents.</p>
      </div>
      <a href="/projets" class="reveal text-sm font-medium text-primary transition-colors duration-200 hover:text-primary/80">
        Tout voir &rarr;
      </a>
    </div>

    <div class="reveal reveal-delay-1 mt-8 grid gap-5 sm:grid-cols-2">
      {featuredProjects.map((project) => (
        <article class="group card-hover overflow-hidden rounded-xl border border-border/50 bg-card">
          {project.cover && (
            <div class="aspect-[16/10] overflow-hidden">
              <img
                src={project.cover}
                alt={`Apercu de ${project.name}`}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>
          )}
          <div class="p-6">
            <div class="mb-3 flex items-center justify-between">
              <h3 class="font-semibold">{project.name}</h3>
              <span class="rounded-full bg-primary/10 px-2.5 py-0.5 text-xs font-medium text-primary">
                {project.status}
              </span>
            </div>
            <p class="mb-4 text-sm leading-relaxed text-muted-foreground">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <span class="rounded-md bg-secondary px-2 py-0.5 text-[11px] font-medium text-secondary-foreground">
                  {tech}
                </span>
              ))}
            </div>
            {project.url && (
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-4 inline-block text-sm font-medium text-primary transition-colors duration-200 hover:text-primary/80"
              >
                Voir le site &rarr;
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Latest blog posts -->
  {latestPosts.length > 0 && (
    <section class="py-20">
      <div class="reveal flex items-end justify-between">
        <div>
          <h2 class="text-lg font-semibold">Derniers articles</h2>
          <p class="mt-1 text-sm text-muted-foreground">Reflexions techniques et veille.</p>
        </div>
        <a href="/blog" class="text-sm font-medium text-primary transition-colors duration-200 hover:text-primary/80">
          Tout voir &rarr;
        </a>
      </div>

      <div class="reveal reveal-delay-1 mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group card-hover block rounded-xl border border-border/50 bg-card p-6"
          >
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
              <time datetime={post.published_at}>
                {new Date(post.published_at).toLocaleDateString('fr-FR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              {post.tags?.length > 0 && (
                <>
                  <span>&middot;</span>
                  {post.tags.slice(0, 2).map((tag: any) => (
                    <span class="rounded-md bg-secondary px-1.5 py-0.5 text-[11px] font-medium">{tag.name}</span>
                  ))}
                </>
              )}
            </div>
            <h3 class="mt-3 font-semibold transition-colors duration-200 group-hover:text-primary">
              {post.title}
            </h3>
            {post.custom_excerpt && (
              <p class="mt-2 text-sm text-muted-foreground line-clamp-2 leading-relaxed">
                {post.custom_excerpt}
              </p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="reveal my-20 overflow-hidden rounded-2xl border border-border/50 bg-accent/50 p-10 text-center sm:p-14">
    <h2 class="text-2xl font-bold tracking-tight">Un projet en tete ?</h2>
    <p class="mx-auto mt-3 max-w-md text-muted-foreground">
      Disponible pour du freelance et des collaborations remote. Decrivons votre projet ensemble.
    </p>
    <a
      href="/contact"
      class="mt-6 inline-flex h-11 items-center rounded-lg bg-primary px-7 text-sm font-medium text-primary-foreground transition-all duration-200 hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 active:scale-[0.98]"
    >
      Me contacter
    </a>
  </section>
</BaseLayout>
