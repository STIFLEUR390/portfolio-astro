---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, projects, skills, images } from '../data/portfolio';
import { getPosts } from '../lib/ghost';

const featuredProjects = projects.filter((p) => p.featured);
const techCount = Object.values(skills).flat().length;

let latestPosts: any[] = [];
try {
  latestPosts = (await getPosts()).slice(0, 3);
} catch {}
---

<BaseLayout>
  <!-- Hero -->
  <section class="grid min-h-[70vh] items-center gap-10 py-16 lg:grid-cols-2">
    <div>
      <p class="mb-3 text-sm font-medium text-primary">Développeur FullStack</p>
      <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">
        {site.author}
      </h1>
      <p class="mt-4 max-w-xl text-lg text-muted-foreground">
        {site.description}
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/contact"
          class="inline-flex h-10 items-center rounded-md bg-primary px-5 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
        >
          Discutons de votre projet
        </a>
        <a
          href="/projets"
          class="inline-flex h-10 items-center rounded-md border border-border px-5 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          Voir les projets
        </a>
      </div>

      <!-- Quick stats -->
      <div class="mt-12 grid grid-cols-3 gap-6 border-t border-border pt-8 text-center">
        <div>
          <p class="text-2xl font-bold text-foreground">6+</p>
          <p class="text-sm text-muted-foreground">Années d'expérience</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-foreground">{featuredProjects.length}+</p>
          <p class="text-sm text-muted-foreground">Projets livrés</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-foreground">{techCount}</p>
          <p class="text-sm text-muted-foreground">Technologies</p>
        </div>
      </div>
    </div>

    <div class="hidden lg:block">
      <img
        src={images.hero}
        alt="Espace de travail de développeur full-stack"
        width="1024" height="1024"
        class="rounded-2xl shadow-xl"
        loading="eager"
      />
    </div>
  </section>

  <!-- Stack -->
  <section class="py-12">
    <h2 class="mb-6 text-lg font-semibold">Stack technique</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {Object.entries(skills).map(([category, items]) => (
        <div>
          <h3 class="mb-2 text-sm font-medium text-muted-foreground">{category}</h3>
          <div class="flex flex-wrap gap-2">
            {items.map((skill) => (
              <span class="inline-block rounded-md border border-border px-2.5 py-1 text-xs font-medium">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured Projects -->
  <section class="py-12">
    <div class="mb-6 flex items-center justify-between">
      <h2 class="text-lg font-semibold">Projets vedettes</h2>
      <a href="/projets" class="text-sm text-primary hover:underline">Tout voir →</a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {featuredProjects.map((project) => (
        <article class="group overflow-hidden rounded-lg border border-border transition-colors hover:border-primary/50 hover:bg-accent/50">
          {project.cover && (
            <img
              src={project.cover}
              alt={`Aperçu de ${project.name}`}
              class="w-full object-cover aspect-video"
              loading="lazy"
            />
          )}
          <div class="p-5">
          <div class="mb-3 flex items-center justify-between">
            <h3 class="font-semibold">{project.name}</h3>
            <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
              {project.status}
            </span>
          </div>
          <p class="mb-4 text-sm text-muted-foreground leading-relaxed">
            {project.description}
          </p>
          <div class="flex flex-wrap gap-1.5">
            {project.stack.map((tech) => (
              <span class="rounded border border-border px-1.5 py-0.5 text-[11px] text-muted-foreground">
                {tech}
              </span>
            ))}
          </div>
          {project.url && (
            <a
              href={project.url}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-4 inline-block text-sm font-medium text-primary hover:underline"
            >
              Voir le site →
            </a>
          )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Latest blog posts -->
  {latestPosts.length > 0 && (
    <section class="py-12">
      <div class="mb-6 flex items-center justify-between">
        <h2 class="text-lg font-semibold">Derniers articles</h2>
        <a href="/blog" class="text-sm text-primary hover:underline">Tout voir →</a>
      </div>

      <div class="space-y-4">
        {latestPosts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group block rounded-lg border border-border p-5 transition-colors hover:border-primary/50 hover:bg-accent/50"
          >
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
              <time datetime={post.published_at}>
                {new Date(post.published_at).toLocaleDateString('fr-FR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              {post.tags?.length > 0 && (
                <>
                  <span>·</span>
                  {post.tags.slice(0, 2).map((tag: any) => (
                    <span class="rounded border border-border px-1.5 py-0.5">{tag.name}</span>
                  ))}
                </>
              )}
            </div>
            <h3 class="mt-2 font-semibold group-hover:text-primary transition-colors">
              {post.title}
            </h3>
            {post.custom_excerpt && (
              <p class="mt-1 text-sm text-muted-foreground line-clamp-2">
                {post.custom_excerpt}
              </p>
            )}
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="my-16 rounded-lg border border-border bg-accent/30 p-8 text-center">
    <h2 class="text-xl font-semibold">Un projet en tête ?</h2>
    <p class="mt-2 text-muted-foreground">
      Disponible pour du freelance et des collaborations remote.
    </p>
    <a
      href="/contact"
      class="mt-5 inline-flex h-10 items-center rounded-md bg-primary px-6 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
    >
      Me contacter
    </a>
  </section>
</BaseLayout>
