---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, socials } from '../data/portfolio';
---

<BaseLayout title="Contact">
  <section class="py-20">
    <div class="reveal">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Contact</h1>
      <p class="mt-3 max-w-xl text-muted-foreground">
        Une idee de projet ? Un poste a pourvoir ? Ecrivez-moi.
      </p>
    </div>

    <div class="reveal reveal-delay-1 mt-12 grid gap-12 lg:grid-cols-5">
      <!-- Formulaire (FormSubmit) -->
      <form
        action="https://formsubmit.co/heroldtamko39@gmail.com"
        method="POST"
        class="lg:col-span-3 space-y-5"
      >
        <!-- FormSubmit config -->
        <input type="hidden" name="_subject" value="Nouveau message depuis le portfolio" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

        <div>
          <label for="name" class="mb-1.5 block text-sm font-medium">Nom</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="h-11 w-full rounded-lg border border-border/60 bg-card px-4 text-sm outline-none transition-all duration-200 focus:border-primary focus:ring-2 focus:ring-primary/20"
            placeholder="Votre nom"
          />
        </div>

        <div>
          <label for="email" class="mb-1.5 block text-sm font-medium">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="h-11 w-full rounded-lg border border-border/60 bg-card px-4 text-sm outline-none transition-all duration-200 focus:border-primary focus:ring-2 focus:ring-primary/20"
            placeholder="vous@exemple.com"
          />
        </div>

        <div>
          <label for="message" class="mb-1.5 block text-sm font-medium">Message</label>
          <textarea
            id="message"
            name="message"
            required
            rows="6"
            class="w-full rounded-lg border border-border/60 bg-card px-4 py-3 text-sm outline-none transition-all duration-200 focus:border-primary focus:ring-2 focus:ring-primary/20"
            placeholder="Decrivez votre projet ou votre demande..."
          ></textarea>
        </div>

        <button
          type="submit"
          class="inline-flex h-11 items-center rounded-lg bg-primary px-7 text-sm font-medium text-primary-foreground transition-all duration-200 hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 active:scale-[0.98]"
        >
          Envoyer
        </button>
      </form>

      <!-- Infos contact -->
      <div class="lg:col-span-2 space-y-6">
        <div class="rounded-xl border border-border/50 bg-card p-5">
          <h2 class="mb-4 text-sm font-semibold">Coordonnees</h2>
          <ul class="space-y-3 text-sm text-muted-foreground">
            <li>
              <span class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Email</span>
              <a href={`mailto:${site.email}`} class="text-primary transition-colors duration-200 hover:text-primary/80">
                {site.email}
              </a>
            </li>
            <li class="border-t border-border/50 pt-3">
              <span class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Telephone</span>
              <a href={`tel:${site.phone}`} class="text-primary transition-colors duration-200 hover:text-primary/80">
                {site.phone}
              </a>
            </li>
            <li class="border-t border-border/50 pt-3">
              <span class="block text-xs font-semibold uppercase tracking-wider text-muted-foreground mb-1">Localisation</span>
              {site.location}
            </li>
          </ul>
        </div>

        <div class="rounded-xl border border-border/50 bg-card p-5">
          <h2 class="mb-4 text-sm font-semibold">Reseaux</h2>
          <div class="flex gap-3">
            {socials.map((s) => (
              <a
                href={s.url}
                target={s.url.startsWith('http') ? '_blank' : undefined}
                rel={s.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="inline-flex h-9 items-center rounded-lg border border-border/60 px-4 text-sm font-medium transition-all duration-200 hover:border-primary/30 hover:text-foreground active:scale-[0.98]"
              >
                {s.label}
              </a>
            ))}
          </div>
        </div>

        <div class="rounded-xl border border-primary/10 bg-primary/5 p-5">
          <p class="text-sm text-muted-foreground">
            <span class="font-medium text-foreground">Disponibilite :</span>
            {' '}Freelance &middot; Remote ou Douala, Cameroun.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
