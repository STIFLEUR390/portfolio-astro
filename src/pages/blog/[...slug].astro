---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/ghost';

export async function getStaticPaths() {
  const PAGE_SIZE = 6;
  const allPosts = await getPosts({ page: 1, limit: 200 });
  const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
  const paths = [];

  // Page 1 (listing)
  paths.push({
    params: { slug: undefined },
    props: {
      type: 'listing' as const,
      posts: allPosts.slice(0, PAGE_SIZE),
      currentPage: 1,
      totalPages,
    },
  });

  // Pages 2..N (listing)
  for (let i = 2; i <= totalPages; i++) {
    const posts = await getPosts({ page: i, limit: PAGE_SIZE });
    paths.push({
      params: { slug: String(i) },
      props: {
        type: 'listing' as const,
        posts,
        currentPage: i,
        totalPages,
      },
    });
  }

  // Individual articles
  for (let i = 0; i < allPosts.length; i++) {
    const post = allPosts[i];
    paths.push({
      params: { slug: post.slug },
      props: {
        type: 'article' as const,
        post,
        prevPost: i > 0 ? { slug: allPosts[i - 1].slug, title: allPosts[i - 1].title } : null,
        nextPost: i < allPosts.length - 1 ? { slug: allPosts[i + 1].slug, title: allPosts[i + 1].title } : null,
      },
    });
  }

  return paths;
}

const { slug } = Astro.props;
const type = Astro.props.type;
---

{type === 'listing' ? (
  <BaseLayout title={Astro.props.currentPage > 1 ? `Blog - Page ${Astro.props.currentPage}` : 'Blog'}>
    <section class="py-20">
      <div class="reveal">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Blog</h1>
        <p class="mt-3 max-w-xl text-muted-foreground">
          Articles techniques sur Laravel, Vue.js, DevOps et veille.
        </p>
      </div>

      <div class="reveal reveal-delay-1 mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {Astro.props.posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group card-hover block overflow-hidden rounded-xl border border-border/50 bg-card"
          >
            {post.feature_image && (
              <div class="aspect-[16/9] overflow-hidden">
                <img
                  src={post.feature_image}
                  alt={post.feature_image_alt || post.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-5">
              <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <time datetime={post.published_at}>
                  {new Date(post.published_at).toLocaleDateString('fr-FR', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                {post.reading_time && (
                  <>
                    <span>&middot;</span>
                    <span>{post.reading_time} min de lecture</span>
                  </>
                )}
              </div>

              <h2 class="mt-2 font-semibold transition-colors duration-200 group-hover:text-primary">
                {post.title}
              </h2>

              {post.custom_excerpt && (
                <p class="mt-2 text-sm text-muted-foreground leading-relaxed line-clamp-2">
                  {post.custom_excerpt}
                </p>
              )}

              {post.tags?.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1.5">
                  {post.tags.map((tag: any) => (
                    <span class="rounded-md bg-secondary px-2 py-0.5 text-[11px] font-medium text-secondary-foreground">{tag.name}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))}
      </div>

      {Astro.props.posts.length === 0 && (
        <p class="mt-12 text-center text-muted-foreground">
          Aucun article pour le moment.
        </p>
      )}

      {/* Pagination */}
      <nav class="mt-12 flex items-center justify-between border-t border-border/50 pt-6">
        {Astro.props.currentPage > 2 ? (
          <a href={`/blog/${Astro.props.currentPage - 1}`} class="inline-flex items-center gap-1.5 rounded-lg border border-border/60 px-4 py-2 text-sm font-medium transition-all duration-200 hover:bg-accent active:scale-[0.98]">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            Precedent
          </a>
        ) : Astro.props.currentPage === 2 ? (
          <a href="/blog" class="inline-flex items-center gap-1.5 rounded-lg border border-border/60 px-4 py-2 text-sm font-medium transition-all duration-200 hover:bg-accent active:scale-[0.98]">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
            Precedent
          </a>
        ) : <div />}

        <span class="text-sm text-muted-foreground">
          Page {Astro.props.currentPage} / {Astro.props.totalPages}
        </span>

        {Astro.props.currentPage < Astro.props.totalPages ? (
          <a href={`/blog/${Astro.props.currentPage + 1}`} class="inline-flex items-center gap-1.5 rounded-lg border border-border/60 px-4 py-2 text-sm font-medium transition-all duration-200 hover:bg-accent active:scale-[0.98]">
            Suivant
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
          </a>
        ) : <div />}
      </nav>
    </section>
  </BaseLayout>
) : (
  <BaseLayout title={Astro.props.post.title} description={Astro.props.post.custom_excerpt ?? Astro.props.post.excerpt}>
    <article class="py-20">
      <!-- Back link -->
      <a href="/blog" class="reveal mb-8 inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors duration-200 hover:text-foreground">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg>
        Retour au blog
      </a>

      <!-- Feature image -->
      {Astro.props.post.feature_image && (
        <div class="reveal mb-8 aspect-[16/9] overflow-hidden rounded-xl border border-border/50">
          <img
            src={Astro.props.post.feature_image}
            alt={Astro.props.post.feature_image_alt || Astro.props.post.title}
            class="h-full w-full object-cover"
          />
          {Astro.props.post.feature_image_caption && (
            <p class="mt-2 text-center text-xs text-muted-foreground italic">
              {Astro.props.post.feature_image_caption}
            </p>
          )}
        </div>
      )}

      <!-- Header -->
      <header class="reveal mb-10">
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <time datetime={Astro.props.post.published_at}>
            {new Date(Astro.props.post.published_at).toLocaleDateString('fr-FR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {Astro.props.post.reading_time && (
            <>
              <span>&middot;</span>
              <span>{Astro.props.post.reading_time} min de lecture</span>
            </>
          )}
        </div>

        <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{Astro.props.post.title}</h1>

        {Astro.props.post.tags?.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {Astro.props.post.tags.map((tag: any) => (
              <span class="rounded-full border border-border/50 bg-secondary px-2.5 py-0.5 text-xs font-medium text-secondary-foreground">
                {tag.name}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Content -->
      <div class="reveal reveal-delay-1 prose prose-neutral dark:prose-invert max-w-none
        prose-headings:font-heading prose-headings:tracking-tight
        prose-a:text-primary prose-a:no-underline hover:prose-a:underline
        prose-code:before:content-none prose-code:after:content-none
        prose-pre:border prose-pre:border-border/50
        prose-img:rounded-lg prose-img:border prose-img:border-border/50">
        <Fragment set:html={Astro.props.post.html} />
      </div>

      <!-- Author -->
      {Astro.props.post.authors?.length > 0 && (
        <footer class="reveal mt-12 border-t border-border/50 pt-6">
          <div class="flex items-center gap-3">
            {Astro.props.post.authors[0].profile_image && (
              <img
                src={Astro.props.post.authors[0].profile_image}
                alt={Astro.props.post.authors[0].name}
                class="h-10 w-10 rounded-full object-cover"
              />
            )}
            <div>
              <p class="text-sm font-medium">{Astro.props.post.authors[0].name}</p>
              <p class="text-xs text-muted-foreground">{Astro.props.post.authors[0].bio}</p>
            </div>
          </div>
        </footer>
      )}

      {/* Prev / Next navigation */}
      {(Astro.props.prevPost || Astro.props.nextPost) && (
        <nav class="reveal mt-12 grid grid-cols-1 gap-4 border-t border-border/50 pt-8 sm:grid-cols-2">
          {Astro.props.prevPost ? (
            <a
              href={`/blog/${Astro.props.prevPost.slug}`}
              class="group card-hover rounded-xl border border-border/50 bg-card p-5"
            >
              <span class="inline-flex items-center gap-1 text-xs text-muted-foreground"><svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" /></svg> Article precedent</span>
              <p class="mt-1.5 text-sm font-medium transition-colors duration-200 group-hover:text-primary">
                {Astro.props.prevPost.title}
              </p>
            </a>
          ) : <div />}

          {Astro.props.nextPost ? (
            <a
              href={`/blog/${Astro.props.nextPost.slug}`}
              class="group card-hover rounded-xl border border-border/50 bg-card p-5 text-right"
            >
              <span class="inline-flex items-center gap-1 text-xs text-muted-foreground">Article suivant <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg></span>
              <p class="mt-1.5 text-sm font-medium transition-colors duration-200 group-hover:text-primary">
                {Astro.props.nextPost.title}
              </p>
            </a>
          ) : <div />}
        </nav>
      )}
    </article>
  </BaseLayout>
)}
