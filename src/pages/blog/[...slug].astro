---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/ghost';

export async function getStaticPaths() {
  const PAGE_SIZE = 6;
  const allPosts = await getPosts({ page: 1, limit: 200 });
  const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
  const paths = [];

  // Page 1 (listing)
  paths.push({
    params: { slug: undefined },
    props: {
      type: 'listing' as const,
      posts: allPosts.slice(0, PAGE_SIZE),
      currentPage: 1,
      totalPages,
    },
  });

  // Pages 2..N (listing)
  for (let i = 2; i <= totalPages; i++) {
    const posts = await getPosts({ page: i, limit: PAGE_SIZE });
    paths.push({
      params: { slug: String(i) },
      props: {
        type: 'listing' as const,
        posts,
        currentPage: i,
        totalPages,
      },
    });
  }

  // Individual articles
  for (let i = 0; i < allPosts.length; i++) {
    const post = allPosts[i];
    paths.push({
      params: { slug: post.slug },
      props: {
        type: 'article' as const,
        post,
        prevPost: i > 0 ? { slug: allPosts[i - 1].slug, title: allPosts[i - 1].title } : null,
        nextPost: i < allPosts.length - 1 ? { slug: allPosts[i + 1].slug, title: allPosts[i + 1].title } : null,
      },
    });
  }

  return paths;
}

const { slug } = Astro.props;
const type = Astro.props.type;
---

{type === 'listing' ? (
  <BaseLayout title={Astro.props.currentPage > 1 ? `Blog — Page ${Astro.props.currentPage}` : 'Blog'}>
    <section class="py-16">
      <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
      <p class="mt-2 text-muted-foreground">
        Articles techniques sur Laravel, Vue.js, DevOps et veille.
      </p>

      <div class="mt-10 space-y-6">
        {Astro.props.posts.map((post) => (
          <article class="group rounded-lg border border-border overflow-hidden transition-colors hover:border-primary/50 hover:bg-accent/50">
            <a href={`/blog/${post.slug}`} class="block">
              {post.feature_image && (
                <div class="aspect-[16/9] overflow-hidden">
                  <img
                    src={post.feature_image}
                    alt={post.feature_image_alt || post.title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                  <time datetime={post.published_at}>
                    {new Date(post.published_at).toLocaleDateString('fr-FR', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  {post.reading_time && (
                    <>
                      <span>·</span>
                      <span>{post.reading_time} min de lecture</span>
                    </>
                  )}
                  {post.tags?.length > 0 && (
                    <>
                      <span>·</span>
                      {post.tags.map((tag: any) => (
                        <span class="rounded border border-border px-1.5 py-0.5">{tag.name}</span>
                      ))}
                    </>
                  )}
                </div>

                <h2 class="mt-2 text-lg font-semibold group-hover:text-primary transition-colors">
                  {post.title}
                </h2>

                {post.custom_excerpt && (
                  <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                    {post.custom_excerpt}
                  </p>
                )}

                <span class="mt-3 inline-block text-sm font-medium text-primary hover:underline">
                  Lire l'article →
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>

      {Astro.props.posts.length === 0 && (
        <p class="mt-10 text-center text-muted-foreground">
          Aucun article pour le moment.
        </p>
      )}

      {/* Pagination */}
      <nav class="mt-10 flex items-center justify-between border-t border-border pt-6">
        {Astro.props.currentPage > 2 ? (
          <a href={`/blog/${Astro.props.currentPage - 1}`} class="inline-flex items-center gap-1 rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground">
            ← Précédent
          </a>
        ) : Astro.props.currentPage === 2 ? (
          <a href="/blog" class="inline-flex items-center gap-1 rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground">
            ← Précédent
          </a>
        ) : <div />}

        <span class="text-sm text-muted-foreground">
          Page {Astro.props.currentPage} / {Astro.props.totalPages}
        </span>

        {Astro.props.currentPage < Astro.props.totalPages ? (
          <a href={`/blog/${Astro.props.currentPage + 1}`} class="inline-flex items-center gap-1 rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground">
            Suivant →
          </a>
        ) : <div />}
      </nav>
    </section>
  </BaseLayout>
) : (
  <BaseLayout title={Astro.props.post.title} description={Astro.props.post.custom_excerpt ?? Astro.props.post.excerpt}>
    <article class="py-16">
      <!-- Back link -->
      <a href="/blog" class="mb-8 inline-block text-sm text-muted-foreground hover:text-foreground transition-colors">
        ← Retour au blog
      </a>

      <!-- Feature image -->
      {Astro.props.post.feature_image && (
        <div class="mb-8 aspect-[16/9] overflow-hidden rounded-lg border border-border">
          <img
            src={Astro.props.post.feature_image}
            alt={Astro.props.post.feature_image_alt || Astro.props.post.title}
            class="h-full w-full object-cover"
          />
          {Astro.props.post.feature_image_caption && (
            <p class="mt-2 text-center text-xs text-muted-foreground italic">
              {Astro.props.post.feature_image_caption}
            </p>
          )}
        </div>
      )}

      <!-- Header -->
      <header class="mb-8">
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <time datetime={Astro.props.post.published_at}>
            {new Date(Astro.props.post.published_at).toLocaleDateString('fr-FR', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {Astro.props.post.reading_time && (
            <>
              <span>·</span>
              <span>{Astro.props.post.reading_time} min de lecture</span>
            </>
          )}
        </div>

        <h1 class="mt-3 text-3xl font-bold tracking-tight">{Astro.props.post.title}</h1>

        {Astro.props.post.tags?.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2">
            {Astro.props.post.tags.map((tag: any) => (
              <span class="rounded-full border border-border px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
                {tag.name}
              </span>
            ))}
          </div>
        )}
      </header>

      <!-- Content -->
      <div class="prose prose-neutral dark:prose-invert max-w-none
        prose-headings:font-heading prose-headings:tracking-tight
        prose-a:text-primary prose-a:no-underline hover:prose-a:underline
        prose-code:before:content-none prose-code:after:content-none
        prose-pre:border prose-pre:border-border
        prose-img:rounded-lg prose-img:border prose-img:border-border">
        <Fragment set:html={Astro.props.post.html} />
      </div>

      <!-- Author -->
      {Astro.props.post.authors?.length > 0 && (
        <footer class="mt-12 border-t border-border pt-6">
          <div class="flex items-center gap-3">
            {Astro.props.post.authors[0].profile_image && (
              <img
                src={Astro.props.post.authors[0].profile_image}
                alt={Astro.props.post.authors[0].name}
                class="h-10 w-10 rounded-full object-cover"
              />
            )}
            <div>
              <p class="text-sm font-medium">{Astro.props.post.authors[0].name}</p>
              <p class="text-xs text-muted-foreground">{Astro.props.post.authors[0].bio}</p>
            </div>
          </div>
        </footer>
      )}

      {/* Prev / Next navigation */}
      {(Astro.props.prevPost || Astro.props.nextPost) && (
        <nav class="mt-12 grid grid-cols-1 gap-4 border-t border-border pt-8 sm:grid-cols-2">
          {Astro.props.prevPost ? (
            <a
              href={`/blog/${Astro.props.prevPost.slug}`}
              class="group rounded-lg border border-border p-4 transition-colors hover:border-primary/50 hover:bg-accent/50"
            >
              <span class="text-xs text-muted-foreground">← Article précédent</span>
              <p class="mt-1 text-sm font-medium group-hover:text-primary transition-colors">
                {Astro.props.prevPost.title}
              </p>
            </a>
          ) : <div />}

          {Astro.props.nextPost ? (
            <a
              href={`/blog/${Astro.props.nextPost.slug}`}
              class="group rounded-lg border border-border p-4 text-right transition-colors hover:border-primary/50 hover:bg-accent/50"
            >
              <span class="text-xs text-muted-foreground">Article suivant →</span>
              <p class="mt-1 text-sm font-medium group-hover:text-primary transition-colors">
                {Astro.props.nextPost.title}
              </p>
            </a>
          ) : <div />}
        </nav>
      )}
    </article>
  </BaseLayout>
)}
