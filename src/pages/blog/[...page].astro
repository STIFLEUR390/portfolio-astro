---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts } from '../../lib/ghost';

export async function getStaticPaths() {
  const PAGE_SIZE = 6;
  const allPosts = await getPosts({ page: 1, limit: 200 });
  const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

  const paths = [];

  // Pages 2..N (page 1 is index.astro)
  for (let i = 2; i <= totalPages; i++) {
    const posts = await getPosts({ page: i, limit: PAGE_SIZE });
    paths.push({
      params: { page: String(i) },
      props: {
        posts,
        currentPage: i,
        totalPages,
      },
    });
  }

  // If no pages beyond 1, return empty (index.astro handles it)
  return paths;
}

const { posts, currentPage, totalPages } = Astro.props;
---

<BaseLayout title={`Blog — Page ${currentPage}`}>
  <section class="py-16">
    <h1 class="text-3xl font-bold tracking-tight">Blog</h1>
    <p class="mt-2 text-muted-foreground">
      Articles techniques sur Laravel, Vue.js, DevOps et veille.
    </p>

    <div class="mt-10 space-y-6">
      {posts.map((post) => (
        <article class="group rounded-lg border border-border overflow-hidden transition-colors hover:border-primary/50 hover:bg-accent/50">
          <a href={`/blog/${post.slug}`} class="block">
            {post.feature_image && (
              <div class="aspect-[16/9] overflow-hidden">
                <img
                  src={post.feature_image}
                  alt={post.feature_image_alt || post.title}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              </div>
            )}
            <div class="p-6">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
              <time datetime={post.published_at}>
                {new Date(post.published_at).toLocaleDateString('fr-FR', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </time>
              {post.reading_time && (
                <>
                  <span>·</span>
                  <span>{post.reading_time} min de lecture</span>
                </>
              )}
              {post.tags?.length > 0 && (
                <>
                  <span>·</span>
                  {post.tags.map((tag: any) => (
                    <span class="rounded border border-border px-1.5 py-0.5">{tag.name}</span>
                  ))}
                </>
              )}
            </div>

            <h2 class="mt-2 text-lg font-semibold group-hover:text-primary transition-colors">
              {post.title}
            </h2>

            {post.custom_excerpt && (
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
                {post.custom_excerpt}
              </p>
            )}

            <span class="mt-3 inline-block text-sm font-medium text-primary hover:underline">
              Lire l'article →
            </span>
            </div>
          </a>
        </article>
      ))}
    </div>

    {/* Pagination */}
    <nav class="mt-10 flex items-center justify-between border-t border-border pt-6">
      {currentPage > 2 ? (
        <a
          href={currentPage === 2 ? '/blog' : `/blog/${currentPage - 1}`}
          class="inline-flex items-center gap-1 rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          ← Précédent
        </a>
      ) : currentPage === 2 ? (
        <a
          href="/blog"
          class="inline-flex items-center gap-1 rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          ← Précédent
        </a>
      ) : (
        <div />
      )}

      <span class="text-sm text-muted-foreground">
        Page {currentPage} / {totalPages}
      </span>

      {currentPage < totalPages ? (
        <a
          href={`/blog/${currentPage + 1}`}
          class="inline-flex items-center gap-1 rounded-md border border-border px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
        >
          Suivant →
        </a>
      ) : (
        <div />
      )}
    </nav>
  </section>
</BaseLayout>
