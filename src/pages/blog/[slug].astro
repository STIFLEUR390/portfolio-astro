---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPosts, getPostBySlug } from '../../lib/ghost';

export async function getStaticPaths() {
  const allPosts = await getPosts({ page: 1, limit: 200 });

  return allPosts.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: i > 0 ? { slug: allPosts[i - 1].slug, title: allPosts[i - 1].title } : null,
      nextPost: i < allPosts.length - 1 ? { slug: allPosts[i + 1].slug, title: allPosts[i + 1].title } : null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
---

<BaseLayout title={post.title} description={post.custom_excerpt ?? post.excerpt}>
  <article class="py-16">
    <!-- Back link -->
    <a href="/blog" class="mb-8 inline-block text-sm text-muted-foreground hover:text-foreground transition-colors">
      ← Retour au blog
    </a>

    <!-- Feature image -->
    {post.feature_image && (
      <div class="mb-8 aspect-[16/9] overflow-hidden rounded-lg border border-border">
        <img
          src={post.feature_image}
          alt={post.feature_image_alt || post.title}
          class="h-full w-full object-cover"
        />
        {post.feature_image_caption && (
          <p class="mt-2 text-center text-xs text-muted-foreground italic">
            {post.feature_image_caption}
          </p>
        )}
      </div>
    )}

    <!-- Header -->
    <header class="mb-8">
      <div class="flex items-center gap-2 text-xs text-muted-foreground">
        <time datetime={post.published_at}>
          {new Date(post.published_at).toLocaleDateString('fr-FR', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {post.reading_time && (
          <>
            <span>·</span>
            <span>{post.reading_time} min de lecture</span>
          </>
        )}
      </div>

      <h1 class="mt-3 text-3xl font-bold tracking-tight">{post.title}</h1>

      {post.tags?.length > 0 && (
        <div class="mt-4 flex flex-wrap gap-2">
          {post.tags.map((tag: any) => (
            <span class="rounded-full border border-border px-2.5 py-0.5 text-xs font-medium text-muted-foreground">
              {tag.name}
            </span>
          ))}
        </div>
      )}
    </header>

    <!-- Content -->
    <div class="prose prose-neutral dark:prose-invert max-w-none
      prose-headings:font-heading prose-headings:tracking-tight
      prose-a:text-primary prose-a:no-underline hover:prose-a:underline
      prose-code:before:content-none prose-code:after:content-none
      prose-pre:border prose-pre:border-border
      prose-img:rounded-lg prose-img:border prose-img:border-border">
      <Fragment set:html={post.html} />
    </div>

    <!-- Author -->
    {post.authors?.length > 0 && (
      <footer class="mt-12 border-t border-border pt-6">
        <div class="flex items-center gap-3">
          {post.authors[0].profile_image && (
            <img
              src={post.authors[0].profile_image}
              alt={post.authors[0].name}
              class="h-10 w-10 rounded-full object-cover"
            />
          )}
          <div>
            <p class="text-sm font-medium">{post.authors[0].name}</p>
            <p class="text-xs text-muted-foreground">{post.authors[0].bio}</p>
          </div>
        </div>
      </footer>
    )}

    {/* Prev / Next navigation */}
    {(prevPost || nextPost) && (
      <nav class="mt-12 grid grid-cols-1 gap-4 border-t border-border pt-8 sm:grid-cols-2">
        {prevPost ? (
          <a
            href={`/blog/${prevPost.slug}`}
            class="group rounded-lg border border-border p-4 transition-colors hover:border-primary/50 hover:bg-accent/50"
          >
            <span class="text-xs text-muted-foreground">← Article précédent</span>
            <p class="mt-1 text-sm font-medium group-hover:text-primary transition-colors">
              {prevPost.title}
            </p>
          </a>
        ) : <div />}

        {nextPost ? (
          <a
            href={`/blog/${nextPost.slug}`}
            class="group rounded-lg border border-border p-4 text-right transition-colors hover:border-primary/50 hover:bg-accent/50"
          >
            <span class="text-xs text-muted-foreground">Article suivant →</span>
            <p class="mt-1 text-sm font-medium group-hover:text-primary transition-colors">
              {nextPost.title}
            </p>
          </a>
        ) : <div />}
      </nav>
    )}
  </article>
</BaseLayout>

<style is:global>
  .prose :where(h1):not(:where([class~="not-prose"],[class~="not-prose"] *)) {
    font-family: var(--font-heading);
  }
</style>

<script>
  import Prism from 'prismjs';
  import 'prismjs/components/prism-markup';
  import 'prismjs/components/prism-css';
  import 'prismjs/components/prism-javascript';
  import 'prismjs/components/prism-typescript';
  import 'prismjs/components/prism-bash';
  import 'prismjs/components/prism-php';
  import 'prismjs/components/prism-json';
  import 'prismjs/components/prism-python';
  import 'prismjs/components/prism-markdown';

  document.addEventListener('DOMContentLoaded', () => {
    Prism.highlightAll();
  });
</script>
