---
import '../styles/globals.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '../styles/prism.css';
import Header from '../components/base/Header.astro';
import FxToggle from '../components/interactive/FxToggle.vue';
import Footer from '../components/base/Footer.astro';
import { site, images } from '../data/portfolio';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const pageTitle = title ? `${title} - ${site.author}` : `${site.author} - Developpeur FullStack`;
const pageDescription = description ?? site.description;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <meta name="author" content={site.author} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={images.og} />
    <meta property="og:image:width" content="2048" />
    <meta property="og:image:height" content="1152" />
    <meta property="og:image:type" content="image/webp" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={images.og} />

    <!-- Canonical -->
    <link rel="canonical" href={`${site.url}${Astro.url.pathname}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <!-- Dark mode: prevent flash -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (stored === 'dark' || (!stored && prefersDark)) {
          document.documentElement.classList.add('dark');
        }

        // Effets animés : état posé avant paint (pas de flash), OFF par
        // défaut si l'utilisateur préfère les animations réduites.
        const fx = localStorage.getItem('fx');
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (fx === '1' || (fx === null && !reduced)) {
          document.documentElement.classList.add('fx-enabled');
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <Header />
    <main class="mx-auto max-w-7xl px-5 sm:px-8 lg:px-12">
      <slot />
    </main>
    <Footer />
    <FxToggle client:load />
    <script>
      import { initFx } from '../lib/fx';
      initFx();
    </script>
    <script>
      // Scroll reveal observer. Every page is fully prerendered and there is
      // no <ClientRouter /> (view transitions), so a plain page load is enough
      // to observe the elements once.
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
