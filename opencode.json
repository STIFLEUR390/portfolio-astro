{
    "$schema": "https://opencode.ai/config.json",
    "compaction": {
        "auto": true
    },
    "default_agent": "build",
    "mcp": {
        "servers": {
            "laravel-boost": {
                "command": ["php", "artisan", "boost:mcp"],
                "type": "local"
            },
            "lerd": {
                "command": ["lerd", "mcp"],
                "type": "local"
            },
          "junctio-coding": {
            "type": "remote",
            "url": "https://junctio.applix.fr/mcp/coding",
            "protocol": "auto"
          },
          "kaneo": {
            "type": "remote",
            "url": "https://kaneo.t2ol.org/api/mcp"
          },
        }
    },
  "model": "opencode-go/muse-spark-1.3-contributor"
}
